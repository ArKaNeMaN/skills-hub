# Copy to .env for local use. Never commit real secrets.

# Required. Token for the web admin login.
SKILLS_HUB_ADMIN_TOKEN=

# Public base URL, e.g. https://hub.example.com when a reverse proxy is used.
PUBLIC_URL=

# Set both to true when a TLS-terminating reverse proxy fronts the service.
TRUST_PROXY=false
REQUIRE_TLS=false

# Host port published on all interfaces to container port 8788.
SKILLS_HUB_PORT=8788

# Optional published image reference. Leave empty to build locally.
# SKILLS_HUB_IMAGE=registry.example.com/example/skills-hub-server:0.0.0
